# Source: Db2 on IBM Cloud (same values as bank_demo/sync/.env)
CLOUD_HOST=<DB2_HOST>
CLOUD_PORT=<DB2_PORT>
CLOUD_DB=BLUDB
CLOUD_USER=
CLOUD_PASSWORD=

# Target: MongoDB on RHEL. The hostname must match the server certificate (SAN).
MONGO_URI=mongodb://bankapp:CHANGE-ME@mongo.example.com:27017/bankdemo?authSource=bankdemo&tls=true
MONGO_DB=bankdemo
# CA that signed the server certificate (omit if it is publicly trusted)
MONGO_CA_FILE=/path/to/mongo-ca.pem
